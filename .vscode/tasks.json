{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build VS Code theme",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "watch",
        "--",
        "vscode"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "theme-build",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[build\\] start$",
          "endsPattern": "^\\[build\\] ready$"
        }
      },
      "isBackground": true
    }
  ]
}
