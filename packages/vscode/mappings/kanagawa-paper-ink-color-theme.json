  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "@theme.syn.comment"
      }
    },
    {
      "name": "Comments: Documentation",
      "scope": [
        "comment.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "@theme.syn.docstring"
      }
    },
    {
      "name": "Invalid - Illegal",
      "scope": "invalid.illegal",
      "settings": {
        "foreground": "@theme.diag.error"
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "@theme.syn.operator"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "@theme.syn.keyword"
      }
    },
    {
      "name": "Types",
      "scope": [
        "storage.type",
        "support.type"
      ],
      "settings": {
        "foreground": "@theme.syn.type"
      }
    },
    {
      "name": "Language Constants",
      "scope": [
        "constant.language",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "@theme.syn.constant"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "@theme.ui.fg"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "@theme.syn.fun"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "@theme.syn.type"
      }
    },
    {
      "name": "Exceptions",
      "scope": "entity.name.exception",
      "settings": {
        "foreground": "@theme.diag.error"
      }
    },
    {
      "name": "Sections",
      "scope": "entity.name.section",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constants",
      "scope": "constant",
      "settings": {
        "foreground": "@theme.syn.constant"
      }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "@theme.syn.number"
      }
    },
    {
      "name": "Characters",
      "scope": "constant.character",
      "settings": {
        "foreground": "@theme.syn.string"
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "@theme.syn.string"
      }
    },
    {
      "name": "Strings: Escape Sequences",
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "@theme.syn.regex"
      }
    },
    {
      "name": "Strings: Regular Expressions",
      "scope": [
        "string.regexp",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "@theme.syn.regex"
      }
    },
    {
      "name": "Strings: Symbols",
      "scope": "constant.other.symbol",
      "settings": {
        "foreground": "@theme.syn.symbol"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "settings": {
        "foreground": "@theme.syn.punct"
      }
    },
    {
      "name": "HTML: Doctype Declaration",
      "scope": [
        "meta.tag.sgml.doctype",
        "meta.tag.sgml.doctype string",
        "meta.tag.sgml.doctype entity.name.tag",
        "meta.tag.sgml punctuation.definition.tag.html"
      ],
      "settings": {
        "foreground": "@theme.syn.preproc"
      }
    },
    {
      "name": "HTML: Tags",
      "scope": [
        "meta.tag",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html"
      ],
      "settings": {
        "foreground": "@theme.syn.punct"
      }
    },
    {
      "name": "HTML: Tag Names",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "@theme.syn.statement"
      }
    },
    {
      "name": "HTML: Attribute Names",
      "scope": [
        "meta.tag entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "@theme.syn.attribute"
      }
    },
    {
      "name": "HTML: Entities",
      "scope": [
        "constant.character.entity",
        "punctuation.definition.entity"
      ],
      "settings": {
        "foreground": "@theme.syn.constant"
      }
    },
    {
      "name": "CSS: Selectors",
      "scope": [
        "meta.selector",
        "meta.selector entity",
        "meta.selector entity punctuation",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "@theme.syn.type"
      }
    },
    {
      "name": "CSS: Property Names",
      "scope": [
        "meta.property-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "@theme.syn.member"
      }
    },
    {
      "name": "CSS: Property Values",
      "scope": [
        "meta.property-value",
        "meta.property-value constant.other",
        "support.constant.property-value"
      ],
      "settings": {
        "foreground": "@theme.syn.string"
      }
    },
    {
      "name": "CSS: Important Keyword",
      "scope": "keyword.other.important",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup: Changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "@theme.vcs.changed"
      }
    },
    {
      "name": "Markup: Deletion",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "@theme.vcs.removed"
      }
    },
    {
      "name": "Markup: Error",
      "scope": "markup.error",
      "settings": {
        "foreground": "@theme.diag.error"
      }
    },
    {
      "name": "Markup: Insertion",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "@theme.vcs.added"
      }
    },
    {
      "name": "Markup: Link",
      "scope": "meta.link",
      "settings": {
        "foreground": "@theme.syn.special3"
      }
    },
    {
      "name": "Markup: Output",
      "scope": [
        "markup.output",
        "markup.raw"
      ],
      "settings": {
        "foreground": "@theme.syn.string"
      }
    },
    {
      "name": "Markup: Prompt",
      "scope": "markup.prompt",
      "settings": {
        "foreground": "@theme.ui.special"
      }
    },
    {
      "name": "Markup: Heading",
      "scope": "markup.heading",
      "settings": {
        "foreground": "@theme.rainbow.rainbow1"
      }
    },
    {
      "name": "Markup: Heading 1",
      "scope": [
        "heading.1.markdown",
        "markup.heading.setext.1.markdown"
      ],
      "settings": {
        "foreground": "@theme.rainbow.rainbow1"
      }
    },
    {
      "name": "Markup: Heading 2",
      "scope": [
        "heading.2.markdown",
        "markup.heading.setext.2.markdown"
      ],
      "settings": {
        "foreground": "@theme.rainbow.rainbow2"
      }
    },
    {
      "name": "Markup: Heading 3",
      "scope": [
        "heading.3.markdown"
      ],
      "settings": {
        "foreground": "@theme.rainbow.rainbow3"
      }
    },
    {
      "name": "Markup: Heading 4",
      "scope": [
        "heading.4.markdown"
      ],
      "settings": {
        "foreground": "@theme.rainbow.rainbow4"
      }
    },
    {
      "name": "Markup: Heading 5",
      "scope": [
        "heading.5.markdown"
      ],
      "settings": {
        "foreground": "@theme.rainbow.rainbow5"
      }
    },
    {
      "name": "Markup: Heading 6",
      "scope": [
        "heading.6.markdown"
      ],
      "settings": {
        "foreground": "@theme.rainbow.rainbow6"
      }
    },
    {
      "name": "Markup: Traceback",
      "scope": "markup.traceback",
      "settings": {
        "foreground": "@theme.diag.error"
      }
    },
    {
      "name": "Markup: Underline",
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "@theme.syn.punct"
      }
    },
    {
      "name": "Markup Lists",
      "scope": "markup.list",
      "settings": {
        "foreground": "@theme.syn.punct"
      }
    },
    {
      "name": "Markup: Bold",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup: Italic",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "@theme.syn.string"
      }
    },
    {
      "name": "Extra: Diff Range",
      "scope": [
        "meta.diff.range",
        "meta.diff.index",
        "meta.separator"
      ],
      "settings": {
        "foreground": "@theme.diff.text"
      }
    },
    {
      "name": "Extra: Diff From",
      "scope": "meta.diff.header.from-file",
      "settings": {
        "foreground": "@theme.diff.delete"
      }
    },
    {
      "name": "Extra: Diff To",
      "scope": "meta.diff.header.to-file",
      "settings": {
        "foreground": "@theme.diff.add"
      }
    }
  ],
  "semanticTokenColors": {
    "arithmetic": "@theme.syn.operator",
    "class": "@theme.syn.type",
    "class.defaultLibrary": "@theme.syn.keyword",
    "enum": "@theme.syn.type",
    "enumMember": "@theme.syn.constant",
    "event": "@theme.syn.type",
    "function": "@theme.syn.fun",
    "function.defaultLibrary": "@theme.syn.fun",
    "interface": "@theme.syn.type",
    "keyword.controlFlow": {
      "foreground": "@theme.syn.statement",
      "fontStyle": "bold"
    },
    "macro": "@theme.syn.preproc",
    "method": "@theme.syn.fun",
    "namespace": "@theme.syn.keyword",
    "newOperator": "@theme.syn.operator",
    "numberLiteral": "@theme.syn.number",
    "operator": "@theme.syn.operator",
    "parameter": "@theme.syn.parameter",
    "parameter.declaration": "@theme.syn.parameter",
    "parameter.definition": "@theme.syn.parameter",
    "property": "@theme.syn.member",
    "property.readonly": "@theme.syn.constant",
    "stringLiteral": "@theme.syn.string",
    "struct": "@theme.syn.type",
    "type": "@theme.syn.type",
    "type.defaultLibrary": "@theme.syn.keyword",
    "typeParameter": "@theme.syn.type",
    "variable": "@theme.ui.fg",
    "variable.readonly": "@theme.syn.constant",
    "variable.readonly.defaultLibrary": "@theme.syn.keyword",
    "variable.defaultLibrary": "@theme.syn.keyword",
    "method.defaultLibrary": "@theme.syn.keyword"
  }
}
